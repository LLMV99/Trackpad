#include "roque_pad.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
    };

    // The trackpad has no physical keyboard matrix.
    // The mock kscan satisfies ZMK without creating a usable key.
    mock_kscan: mock_kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

// Cirque Pinnacle is the only input device on this shield.
&input_listener_unibody0 {
    status = "okay";
    device = <&input_device_unibody0>;
};
